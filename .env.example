# Chép thành .env (KHÔNG commit). Sinh bí mật: openssl rand -hex 32
# Chọn MỘT tệp phụ: máy có nginx-proxy-manager → docker-compose.npm.yml ; máy trống → docker-compose.caddy.yml
COMPOSE_FILE=docker-compose.yml:docker-compose.npm.yml
TEN_MIEN=cuuho.websitekhoinghiep.net

POSTGRES_USER=sos_vung_lu
POSTGRES_DB=sos_vung_lu
POSTGRES_PASSWORD=
# Mật khẩu tài khoản quyền thấp sos_app (app dùng). Chỉ có hiệu lực lúc Postgres khởi tạo lần đầu.
MAT_KHAU_CSDL_APP=
# Ký phiên đăng nhập (>= 32 ký tự). Đổi = mọi người đăng nhập lại một lượt.
AUTH_SECRET=
# Khoá riêng cho cron gọi /api/tac-vu/* (>= 32 ký tự), KHÔNG dùng chung AUTH_SECRET.
KHOA_TAC_VU=

# Số gọi cứu hộ (mặc định 112) và số tổng đài nhận SMS SOS dự phòng (để trống: dân tự chọn người nhận)
SO_HOTLINE=112
SO_SMS_SOS=
# SOS khẩn (không tài khoản): tối đa bao nhiêu SOS/ngày cho mỗi địa chỉ mạng và mỗi SĐT (mặc định 100)
HAN_MUC_SOS_KHACH_NGAY=100
# (Tuỳ chọn) nền bản đồ riêng có khoá, dạng https://.../{z}/{x}/{y}.png — để trống dùng Esri miễn phí
BAN_DO_URL=
BAN_DO_NGUON=

# Chạy trên máy tính (npm run dev) với Postgres cục bộ:
# DATABASE_URL=postgresql://sos_vung_lu:matkhau@localhost:5432/sos_vung_lu
