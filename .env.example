# Chép file này thành .env.local rồi điền. Để trống Supabase → app chạy bản demo (lưu trên máy).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Số tổng đài nhận SMS SOS dự phòng (để trống: người dân tự chọn người nhận)
VITE_SOS_SMS_NUMBER=
# Số gọi cứu hộ (mặc định 112)
VITE_RESCUE_HOTLINE=
# (Tùy chọn) Nền bản đồ riêng có khóa, dạng https://.../{z}/{x}/{y}.png; để trống dùng Esri miễn phí
VITE_MAP_TILE_URL=
# Dòng ghi nguồn của nhà cung cấp bản đồ trên, vd: &copy; MapTiler &copy; OpenStreetMap contributors
VITE_MAP_ATTRIBUTION=
# (Tùy chọn) Khóa Google Maps JavaScript API; có khóa thì Google là nền mặc định. Nhớ đặt hạn mức ngày.
VITE_GOOGLE_MAPS_KEY=
